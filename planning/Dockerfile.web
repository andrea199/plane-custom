ARG API_IMAGE=oniro-plane-api:planning-v1
ARG BASE_IMAGE=plane-web-custom:latest
FROM ${API_IMAGE} AS patcher
FROM ${BASE_IMAGE} AS original
FROM patcher AS prepared
COPY --from=original /usr/share/nginx/html/index.html /usr/share/nginx/html/index.html
COPY --from=original /etc/nginx/nginx.conf /etc/nginx/nginx.conf
COPY install_web.py /tmp/install_oniro_planning_web.py
RUN python /tmp/install_oniro_planning_web.py
FROM original
COPY --from=prepared /usr/share/nginx/html/index.html /usr/share/nginx/html/index.html
COPY --from=prepared /etc/nginx/nginx.conf /etc/nginx/nginx.conf
COPY web /usr/share/nginx/html/oniro-planning
RUN nginx -t
